{
    "manifest_version": 3,
    "name": "Lecture doubt catcher",
    "version": "1.0",
    "description": "A Chrome extension to catch doubts during Youtube lectures and save timestamp to resolve later.",
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ], 
    "action": {
        "default_icon": "icon1.png"
    },
    "background": {
    "service_worker": "background.js"
  }, 
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"], 
            "js": ["content.js"]

        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["dashboard.html", "dashboard.js", "styles.css", "expanded.html", "expanded.js"],
             "matches": ["*://*.youtube.com/*"]
        }
    ]
}

